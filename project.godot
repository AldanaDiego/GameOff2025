; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OverTheHeatwave"
run/main_scene="res://scenes/main/scene_manager.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalConstants="*res://scripts/autoload/global_constants.gd"
GlobalTools="*res://scripts/autoload/global_tools.gd"
InputDisplay="*res://scripts/autoload/input_display.gd"
ConfigOptions="*res://scripts/autoload/config_options.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "red",
"res://scenes/": "green",
"res://scripts/": "blue"
}

